# CULINA environment — copy to .env if you need to customize.
# There are deliberately NO API keys or secrets: every enabled provider is
# keyless and called directly from the browser (one CORS-restricted provider
# is proxied by the gateway, also keylessly). Key-requiring providers stay
# disabled and would take their secrets via the SERVER environment only.

# Port for the production gateway (server.js). Not used by vite dev/build.
PORT=3000
